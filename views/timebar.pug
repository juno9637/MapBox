//- Time scrubber bar — visual structure modeled on building.pug's time slider:
//- hour labels above, a continuous range input in the middle, a readout chip
//- below. The slider's underlying value is hour-of-day (6..18) for visual
//- semantics, but timebar.js normalizes it to [0, 1] before dispatching
//- "timebar:change", which is what map.js consumes.
//-
//- Open via "timebar:open" custom event; closes on "timebar:close" or Escape.
.timebar(data-state="closed" role="region" aria-label="Time scrubber")
    .timebar__labels(aria-hidden="true")
        span 6a
        span 7
        span 8
        span 9
        span 10
        span 11
        span 12p
        span 1
        span 2
        span 3
        span 4
        span 5
        span 6p
    input.timebar__slider#timebar-slider(
        type="range"
        min="6"
        max="18"
        step="1"
        value="12"
        aria-label="Time of day"
    )
    .timebar__readout 12:00 PM
